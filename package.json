{
  "name": "gamer-gorl-bot",
  "private": true,
  "version": "1.0.0",
  "description": "gamerGorlBot (ggb) compares the steam wishlists of your friends and lets you know if any of y'all's wish list games are on sale!",
  "main": "app.js",
  "type": "module",
  "engines": {
    "node": ">=18.x"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "register": "tsc && node dist/commands.js",
    "dev": "tsc --watch & node --watch  dist/app.js"
  },
  "author": "John Mathena",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "discord-interactions": "^4.0.0",
    "dotenv": "^16.0.3",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "nodemon": "^3.0.0",
    "typescript": "^7.0.2"
  }
}
